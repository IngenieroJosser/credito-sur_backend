# pnpm 11 verifica las dependencias antes de `pnpm run` y, si no cuadran con el
# lockfile, LAS INSTALA. En el servidor eso convertia el arranque en una
# instalacion completa: descargaba los binarios de @swc/core para macOS y
# Windows (que solo hacen falta para compilar) y agotaba la memoria del plan.
#
# El arranque debe limitarse a arrancar: si faltan dependencias, es la fase de
# compilacion la que debe fallar, no el arranque la que las repare.
verify-deps-before-run=false
